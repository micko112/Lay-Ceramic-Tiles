@Composable
fun ScreenCalculate() {
    var values by remember { mutableStateOf(List(5) { "" }) }
    //val calculation
    Column(modifier = Modifier.fillMaxSize()) {
        Spacer(modifier = Modifier.height(120.dp))
        InputCrossLayout(
            values = values,
            onValueChange = { index, newValue ->
                values = values.toMutableList().also { it[index] = newValue }
            }
        )
        //CustomButton("CALCULATE", onClick = calculation)
        Column {
            Row {
                Text("Results: Area(m2)")
            }
            Row {
                Text("Floor = ")
            }
            Row {
                Text("Wall = ")
            }
            Row {
                Text("Tiles needed = ")
            }
            Row {
                Text("Floor tiles = ")
            }
            Row {
                Text("Wall tiles = ")
            }

        }
    }

}
